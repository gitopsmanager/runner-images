# Every tool version and checksum the runner images install, in one place,
# so a bump is one edit here and every image that has the tool picks it up.
# Read by install-tools.sh (at build) and smoke-test.sh (after build).
#
# Rules (see ../README.md, "Bumping a version"):
# - Exact versions only, each at least two weeks old when pinned.
# - The checksum is the SHA256 of the file at the URL install-tools.sh
#   builds from the version. Where the project publishes one, it is copied
#   from there; where it doesn't, it was computed from a download and the
#   comment says so.
# - amd64 only: CodeBuild and Container Apps jobs run these on x86_64.
#
# Pinned 29 Oct 2026.

# OpenTofu, github.com/opentofu/opentofu releases (1 Oct 2026).
# From tofu_1.13.1_SHA256SUMS on the release.
OPENTOFU_VERSION=1.13.1
OPENTOFU_SHA256=378ada19d4bc70c43732004e8159be771b23b9a5afdf059e5f8a2b3fa2c70a69

# kubectl, dl.k8s.io (release/stable-1.36.txt). From kubectl.sha256 next to
# the binary.
KUBECTL_VERSION=1.36.6
KUBECTL_SHA256=29818b6729dc9262b692307470d0558d027725e738be5dd47c760261868a2634

# Helm 3, get.helm.sh (15 Oct 2026). From the .sha256sum next to the archive.
# Helm 3, not 4: the component workflows render with Helm 3.
HELM_VERSION=3.22.1
HELM_SHA256=896cf63684a42a723d61c980369d6e588330927deb13676ca0d85006dd6da0ea

# kustomize, kubernetes-sigs/kustomize release kustomize/v5.8.3 (8 Oct 2026).
# From checksums.txt on the release.
KUSTOMIZE_VERSION=5.8.3
KUSTOMIZE_SHA256=cb9e31198d3f63b44848bd0afc4c8efc56e6cfef9c93a4a39a211940e6decd61

# yq, mikefarah/yq (29 Sep 2026). The release's `checksums` file lists many
# hash types per line (order in checksums_hashes_order); this is its SHA-256
# column, and matches a download.
YQ_VERSION=4.54.1
YQ_SHA256=8e34fc298390875de416e6a4afcb8cabeceb25d9aa8506c1a2f9353cf702ea5f
# crane (google/go-containerregistry): pushes an OCI archive to a registry
# without Docker (the cluster monitor image, upgrade-cluster-monitor.yml).
CRANE_VERSION=0.22.1
CRANE_SHA256=0ab7a1d6932a213aed964ce97666c3077fe691c8606413674a8b3e0b9ec4cda0

# kubelogin, Azure/kubelogin (23 Sep 2026). From the .zip.sha256 on the
# release.
KUBELOGIN_VERSION=0.2.20
KUBELOGIN_SHA256=2e92450a929dd2aec4da818b40dd4fda97aaeae2d6cd9c1074cc1371210f4ab9

# AWS CLI v2, awscli.amazonaws.com (tag 2.38.1, 14 Oct 2026). AWS publishes
# only a PGP signature, so this was computed from a download whose signature
# verified against the AWS CLI Team key FB5DB77FD5C118B80511ADA8A6310ACC4672475C.
AWSCLI_VERSION=2.38.1
AWSCLI_SHA256=b11ed416d91f4251da363a17706938eeaf0e520745754c104c0c1890dd8363c7

# Azure CLI, Microsoft's apt repo (packages.microsoft.com/repos/azure-cli,
# noble, 5 Oct 2026). The .deb is fetched from the repo's pool by exact
# version; the checksum is the SHA256 field of the repo's Packages index,
# which a download matched.
AZURE_CLI_VERSION=2.91.0
AZURE_CLI_DEB_VERSION=2.91.0-1~noble
AZURE_CLI_SHA256=826aa273a138647c1a2274df8dfb0f1e9351c3d25d9d6fec29ae96eb2a9031e8

# Ubuntu packages (python3, PyYAML, and the Azure CLI's dependencies) come
# from snapshot.ubuntu.com at this instant, not the live archive, so a
# rebuild installs the same versions. The live archive drops old versions
# when it updates, so an exact version pin alone would break the build.
UBUNTU_SNAPSHOT=20261015T000000Z
PYTHON3_DEB_VERSION=3.12.3-0ubuntu2.1
PYYAML_DEB_VERSION=6.0.1-2build2
PYYAML_VERSION=6.0.1
